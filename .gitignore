# ============================================================================
# KEEP THESE FILES (DO NOT IGNORE)
# ============================================================================

# Always include these
!.env.example
!.gitignore
!requirements.txt
!README.md
!LICENSE
!CONTRIBUTING.md

# Keep data structure files (but not actual user data)
!data/.gitkeep
!data/certifications.yaml
!data/questions.yaml
!data/resources.yaml

# Keep empty directories with .gitkeep
!**/.gitkeep

# Keep example configuration files
!config/*.example
!config/*.sample

# ============================================================================
# GEMINI API SPECIFIC
# ============================================================================

# Google AI Studio exports
*.aistudio
gemini_history/

# Model cache
model_cache/
.gemini_cache/

# ============================================================================
# END OF .gitignore
# ============================================================================